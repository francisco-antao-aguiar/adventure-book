    {
      "name": "4. Play without a player",
      "item": [
        {
          "name": "Start",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.section) {",
                  "    pm.collectionVariables.set(\"sectionNumber\", res.section.sectionNumber);",
                  "    pm.collectionVariables.set(\"health\", res.health);",
                  "    if (res.section.options.length > 0) {",
                  "        pm.collectionVariables.set(\"optionId\", res.section.options[0].id);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/book/{{bookId}}/play/start",
              "host": [
