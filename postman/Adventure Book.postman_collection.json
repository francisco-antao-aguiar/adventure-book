      "name": "1. Books",
      "item": [
        {
          "name": "Add a book",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"bookId\", pm.response.json().id);"
